{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "py -3 .cursor/hooks/fix_utf16_after_edit.py",
        "timeout": 15
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "py -3 .cursor/hooks/fix_utf16_after_edit.py",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "py -3 .cursor/hooks/fix_utf16_after_edit.py",
        "matcher": "Write|StrReplace|EditNotebook",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "py -3 .cursor/hooks/block_goldclub_boot_tamper.py",
        "matcher": "bcdboot|bcdedit\\s+/store|BIWINSYS|BIWINSOFT|_fix-biwin|_patch-biwin-boot|_repair-biwin|_unload-biwin-hive|CrashControl|bootmgfw\\.efi",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "py -3 .cursor/hooks/block_goldclub_boot_tamper.py",
        "matcher": "bcdboot|bcdedit\\s+/store|BIWINSYS|BIWINSOFT|_fix-biwin|_patch-biwin-boot|_repair-biwin|_unload-biwin-hive|CrashControl|bootmgfw\\.efi",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}